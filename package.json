{
  "name": "cyi-radio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "build": "node scripts/build-frontend.mjs",
    "build:deploy": "node scripts/build-frontend.mjs --deploy",
    "start": "node --env-file-if-exists=.env app.js",
    "db:generate": "drizzle-kit generate --config drizzle.config.cjs",
    "db:inspect": "node scripts/db.cjs inspect",
    "db:migrate": "node --env-file-if-exists=.env scripts/db.cjs migrate",
    "db:status": "node --env-file-if-exists=.env scripts/db.cjs status",
    "db:verify": "node --env-file-if-exists=.env scripts/db.cjs verify",
    "schedule:manage": "node --env-file-if-exists=.env scripts/schedule.cjs",
    "chat:manage": "node --env-file-if-exists=.env scripts/chat.cjs",
    "probe:socket": "node probes/phase-0/socket-probe.cjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pg": "^8.16.3",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io-client": "^4.8.3",
    "vite": "^7.3.1"
  }
}
